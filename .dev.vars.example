# 本地开发变量示例（复制为 .dev.vars 并填入真实值，切勿提交）
# 只读版已移除 ADMIN_TOKEN，配置写接口全部禁用
PROBE_TOKEN=change-me-probe
PROBE_REGION=cf-edge

# 告警地址与开关：真实值请放在 Cloudflare Dashboard，不要写死在代码里
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://ntfy.588816.xyz/<your-token>.send?text=【服务监测】&desp=监测服务出现故障！
ALERT_SIGNING_SECRET=change-me-signing
# 设为 1 = 检测到宕机/无法联通立即推送（推荐）；未设置则沿用监控项 failureThreshold
ALERT_FAILURE_THRESHOLD=1
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=you@example.com
RESEND_API_KEY=
EMAIL_FROM=

# 监控目标默认来自 src/config.mjs 的 MONITORS 数组。
# 本地调试可用 MONITORS_JSON 临时覆盖（JSON 数组）；留空则使用代码内配置。
MONITORS_JSON=
